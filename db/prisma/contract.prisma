  @@index([special_month, special_day, id], where: "(is_published AND (special_month IS NOT NULL))", map: "quiz_questions_special_date_idx")
  @@index([category, id], map: "quiz_questions_category_idx")
  @@index([updated_at, id], map: "quiz_questions_admin_list_idx")
  @@map("quiz_questions")
}

model TagTranslations {
  tag_id                  Uuid
  locale                  String
  name                    String
  tag_translations_tag_id Tags   @relation("tag_translations_tag_id_fkey", fields: [tag_id], references: [id], onDelete: Cascade, index: false, map: "tag_translations_tag_id_fkey")

  @@id([tag_id, locale], map: "tag_translations_pkey")
  @@unique([locale, name], map: "tag_translations_locale_name_key")
  @@check(expression: "(btrim(name) <> ''::text)", map: "tag_translations_name_check")
  @@check(expression: "(locale = ANY (ARRAY['ja'::text, 'en'::text]))", map: "tag_translations_locale_check")
  @@map("tag_translations")
}

model Tags {
  id                                    Uuid
  key                                   String
  PubTagsByPubTagsTagId                 PubTags[]         @relation("pub_tags_tag_id_fkey")
  TagTranslationsByTagTranslationsTagId TagTranslations[] @relation("tag_translations_tag_id_fkey")

  @@id([id], map: "tags_pkey")
  @@unique([key], map: "tags_key_unique")
  @@map("tags")
}
