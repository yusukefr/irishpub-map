{
  "name": "irishpub-map",
  "version": "0.1.65",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "import-pubs": "node scripts/import-pubs.mjs",
    "db:connection-check": "node scripts/check-neon-connection.mjs",
    "db:preflight": "node scripts/check-neon-preflight.mjs",
    "db:migrate": "node scripts/run-neon-migration.mjs",
    "db:schema": "node scripts/generate-database-schema.mjs",
    "generate:database-schema": "node scripts/generate-database-schema.mjs --target production",
    "check:database-schema": "node scripts/generate-database-schema.mjs --target production --check",
    "prisma:version": "prisma --version",
    "prisma:help": "prisma --help",
    "prisma:contract:emit": "prisma contract emit && prettier --write generated/prisma8/contract.json generated/prisma8/contract.d.ts",
    "validate:production-env": "node scripts/validate-production-env.mjs",
    "lint": "eslint --config eslint.config.mjs apps/web/app apps/mobile packages/shared/src packages/api-client/src e2e playwright.config.ts playwright.storybook.config.ts --max-warnings=0",
    "lint:openapi": "redocly lint docs/specs/openapi/openapi.yaml",
    "test:openapi-contract": "vitest run tests/web/openapi-route-contract.test.ts",
    "typecheck": "npm run typecheck -w apps/web && npm run typecheck -w apps/mobile && npm run typecheck:api-client && npm run typecheck:e2e",
    "typecheck:api-client": "tsc --noEmit --project packages/api-client/tsconfig.json",
    "typecheck:e2e": "tsc --noEmit --project tsconfig.e2e.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:storybook": "playwright test --config playwright.storybook.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "node scripts/install-git-hooks.mjs",
    "check:sensitive-data": "node scripts/check-sensitive-data.mjs --tracked",
    "check:llm-security": "node scripts/check-llm-security.mjs --tracked",
    "format:docs:check": "node tools/docs-check/check-doc-format.mjs",
    "check:mermaid": "node tools/docs-check/check-mermaid.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "@hono/node-server": "2.1.4",
    "diff": "5.2.2",
    "postcss": "8.5.29",
    "react-native": "0.88.0",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "eslint": "10.11.0",
    "@prisma/orm-postgres": "8.0.0-rc.17",
    "@redocly/cli": "^2.64.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "agent-browser": "0.36.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^30.1.1",
    "mermaid": "12.1.0",
    "neon": "8.3.5",
    "prettier": "^3.9.9",
    "prisma": "8.0.0-rc.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "^10.6.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  }
}
