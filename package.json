{
  "name": "irishpub-map",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "update-app-version": "node scripts/update-app-version.mjs",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "node scripts/install-git-hooks.mjs",
    "check:sensitive-data": "node scripts/check-sensitive-data.mjs --tracked"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  }
}
