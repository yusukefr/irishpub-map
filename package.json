{
  "name": "irishpub-map",
  "version": "0.1.53",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "import-pubs": "node scripts/import-pubs.mjs",
    "export-municipality-csv": "node scripts/export-municipality-codes.mjs",
    "validate:production-env": "node scripts/validate-production-env.mjs",
    "update-app-version": "node scripts/update-app-version.mjs",
    "lint": "eslint --config eslint.config.mjs apps/web/app packages/shared/src --max-warnings=0",
    "typecheck": "npm run typecheck -w apps/web",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "node scripts/install-git-hooks.mjs",
    "check:sensitive-data": "node scripts/check-sensitive-data.mjs --tracked",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.1.11",
    "agent-browser": "^0.34.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vitest": "^4.1.11",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  }
}
