# Optional GitHub pull request metadata; export before running scripts/create-pr.sh.
PR_REVIEWER=
PR_ASSIGNEE=

# API key for GET /api/pubs.
# Required in Vercel Production; optional locally and in Preview.
# When configured outside Production, requests also require x-api-key.
IRISHPUB_MAP_API_KEY=

# Optional Vercel Deployment Protection bypass secret for server-side self-fetches in Preview deployments.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Neon Postgres connection string. Required for public Guide content, persistence, and admin writes.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Admin authentication. Set all three values to enable admin login.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Automation API authentication. Generate both values in an interactive terminal with
# `node scripts/generate-automation-token.mjs`. Store only the SHA-256 on the server.
# Configure separately for local, Preview, and Production environments.
AUTOMATION_API_TOKEN_SHA256=
AUTOMATION_API_SCOPES=
