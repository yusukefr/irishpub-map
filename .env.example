# Optional GitHub pull request metadata; export before running scripts/create-pr.sh.
PR_REVIEWER=
PR_ASSIGNEE=

# API key for GET /api/pubs.
# Required in Vercel Production; optional locally and in Preview.
# When configured outside Production, requests also require x-api-key.
IRISHPUB_MAP_API_KEY=

# Optional Vercel Deployment Protection bypass secret for server-side self-fetches in Preview deployments.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Neon Postgres connection string. Required for persistence and admin writes.
DATABASE_URL=

# Admin authentication. Set all three values to enable admin login.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
