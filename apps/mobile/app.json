{
  "expo": {
    "name": "Irish Pub Map",
    "slug": "irishpub-map",
    "scheme": "irishpubmap",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地を地図に表示し、近くのパブを探すために位置情報を利用します。",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "jp.irishpubmap.app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d3529d20-f828-4916-b5df-ef11a32e5184"
      }
    },
    "owner": "yf-techs"
  }
}
